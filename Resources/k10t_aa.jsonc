{"name":"K10-T (T-80UM2)","fov":16,"units":"mil","lights":{"from_host":true},"style":{"w":0.25},"vars":{"Div":10,"TickShort":3,"TickLong":6,"RingIn":80,"RingOut":120},"elements":[{"group":"Boresight","align":"Boresight","elements":[{"line":[0,0,0,"2 * RingOut"]},{"line":[0,0,90,"2 * RingOut"]},{"for":"side","in":[-1,1],"do":[{"for":"k","in":"1 .. 4","do":[{"line":["side * k * Div",0,90,"k % 2 == 0 ? TickLong : TickShort"]},{"line":[0,"side * k * Div",0,"k % 2 == 0 ? TickLong : TickShort"]}]}]},{"circle":[0,0,"RingIn"],"segments":64},{"circle":[0,0,"RingOut"],"segments":64}]}]}